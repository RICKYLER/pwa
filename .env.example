# AI situational brief (Ollama cloud, OpenAI-compatible endpoint)
AI_API_KEY=
AI_BASE_URL=https://ollama.com/v1
AI_MODEL=gpt-oss:120b

# ─────────────────────────────────────────────────────────────────────────────
# Cloudflare (Free Plan) — CDN, HTTPS, DDoS, Basic WAF
# ─────────────────────────────────────────────────────────────────────────────
# HOW TO GET THESE VALUES:
#
# CLOUDFLARE_API_TOKEN:
#   1. Go to https://dash.cloudflare.com/profile/api-tokens
#   2. Click "Create Token" → "Create Custom Token"
#   3. Add these permissions (Zone level, select your domain):
#      - Zone → Cache Rules → Edit
#      - Zone → WAF → Edit
#      - Zone → Zone Settings → Read
#      - Zone → Analytics → Read
#   4. Under "Zone Resources": Include → Specific zone → your domain
#   5. Click "Continue to summary" → "Create Token"
#
# CLOUDFLARE_ZONE_ID:
#   Go to Cloudflare dashboard → click your domain → right sidebar → "Zone ID"
#
# CLOUDFLARE_ACCOUNT_ID:
#   Go to Cloudflare dashboard → right sidebar → "Account ID"
#
# ⚠️  NEVER prefix these with NEXT_PUBLIC_ — server-side only!
# ⚠️  NEVER commit real token values to git!

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=
